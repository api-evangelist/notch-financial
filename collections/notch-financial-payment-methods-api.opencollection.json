            "url": "https://api.notch.financial/payment-methods"
          },
          "docs": "List stored payment methods (unreconciled)."
        },
        {
          "info": {
            "name": "Store a payment method (unreconciled).",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.notch.financial/payment-methods",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Store a payment method (unreconciled)."
        }
      ]
    }
  ],
  "bundled": true
}