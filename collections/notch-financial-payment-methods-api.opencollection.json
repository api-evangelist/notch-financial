{
  "opencollection": "1.0.0",
  "info": {
    "name": "Notch API (unreconciled capability model) Bank Accounts Payment Methods API",
    "version": "0.0.0-unreconciled"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Methods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List stored payment methods (unreconciled).",
            "type": "http"
          },
