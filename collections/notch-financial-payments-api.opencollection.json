            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Collect or record a payment (unreconciled)."
        },
        {
          "info": {
            "name": "Retrieve a payment (unreconciled).",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.notch.financial/payments/:paymentId",
            "params": [
              {
                "name": "paymentId",
                "value": "",
                "type": "path"
              }
            ]
